# Copy to .env. Every value has a working default; with none of them set, the whole
# benchmark runs against the deterministic mock provider and SQLite.

# --- model ---------------------------------------------------------------------
# Leave blank to use the offline mock provider.
ANTHROPIC_API_KEY=
MODEL=claude-sonnet-4-5
TEMPERATURE=0.0
MAX_TOKENS=1200
# auto | anthropic | mock   (auto = anthropic if a key is set, else mock)
LLM_PROVIDER=auto

# --- tracing -------------------------------------------------------------------
# From the LangFuse UI at http://localhost:3000 after `docker compose up -d`.
# Blank keys disable tracing entirely; nothing else changes.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

# --- storage -------------------------------------------------------------------
# SQLite by default so `crt bench --store` works with nothing running.
DATABASE_URL=sqlite:///crt_runs.db
# DATABASE_URL=postgresql+psycopg2://crt:crt@localhost:5432/crt_db

# --- benchmark -----------------------------------------------------------------
SEED=20260825
