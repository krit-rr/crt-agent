# Copy to .env. 
# Every value has a working default; with none of them set, 
##the whole benchmark runs against the deterministic mock provider and SQLite.

# Model ---------------------------------------------------------------------
# auto        Anthropic if ANTHROPIC_API_KEY is set, else the offline mock
# anthropic   Messages API, needs a key
# claude-cli  `claude -p`, billed to your Pro/Max subscription. NO API KEY NEEDED.
#             Requires Claude Code installed and `claude login` done.
# mock        Deterministic, offline, no network
LLM_PROVIDER=auto

ANTHROPIC_API_KEY=
MODEL=claude-sonnet-4-5
TEMPERATURE=0.0
MAX_TOKENS=1200

# Claude-cli provider ---------------------------------------------------------
CLAUDE_BINARY=claude
CLAUDE_TIMEOUT_S=180
# low | medium | high | xhigh | max. Blank uses the CLI default.
# Note: no effort level suppresses reasoning, which is why this backend cannot
# sample a System 1 answer and the report prints n/a for those columns.
CLAUDE_EFFORT=

# Tracing -------------------------------------------------------------------
# From the LangFuse UI at http://localhost:3000 after `docker compose up -d`.
# Blank keys disable tracing entirely; nothing else changes.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

# Storage -------------------------------------------------------------------
# SQLite by default so `crt bench --store` works with nothing running.
DATABASE_URL=sqlite:///crt_runs.db
# DATABASE_URL=postgresql+psycopg2://crt:crt@localhost:5432/crt_db

# Benchmark -----------------------------------------------------------------
SEED=20260825
